# Copy to .env and adjust. Never commit .env.

# --- Database ---------------------------------------------------------------
# Host port the container publishes on. Default 5433, NOT 5432, because a locally
# installed PostgreSQL usually already owns 5432 — if you point at 5432 you may
# silently connect to that server instead of this project's PostgreSQL 16.
DB_PORT=5433
DATABASE_URL=postgresql://bidhub:bidhub@localhost:5433/bidhub

# --- API server -------------------------------------------------------------
PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Set to true to run the auction auto-close job (CALL close_expired_auctions())
# on an interval from the Node process. See server/src/jobs/closeAuctions.js.
ENABLE_AUCTION_JOB=true
AUCTION_JOB_INTERVAL_MS=60000

# --- Client -----------------------------------------------------------------
VITE_API_URL=http://localhost:4000
